{
  "name": "desktop-agent-enterprise-env",
  "productName": "Private Agent",
  "version": "0.1.0",
  "private": true,
  "description": "LLM과 함께하는 개인용 Prompt · LLM Wiki",
  "author": "Private Agent",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ready": "node scripts/run-dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:browser": "node scripts/setup-browser.mjs",
    "setup:electron": "node scripts/setup-electron.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "build:web": "next build",
    "build:python": "node scripts/build-python.mjs",
    "build": "npm run build:web && npm run build:python",
    "build:exe": "node scripts/build-exe.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src electron scripts tests *.json *.ts *.md .github/workflows/*.yml",
    "format:check": "prettier --check src electron scripts tests *.json *.ts *.md .github/workflows/*.yml",
    "test:python": "node scripts/test-python.mjs",
    "test:e2e": "playwright test",
    "test:main": "node --test tests/files.test.cjs tests/storage.test.cjs tests/backend-process.test.cjs tests/context-menu.test.cjs tests/relaunch.test.cjs tests/sites.test.cjs tests/links.test.cjs tests/reminders.test.cjs tests/schedules.test.cjs tests/routines.test.cjs tests/import-notices.test.cjs tests/api-server.test.cjs tests/mcp.test.cjs tests/mcp-stdio.test.cjs tests/api-settings.test.cjs tests/api-methods.test.cjs tests/app-control.test.cjs tests/diagnostics.test.cjs tests/package.test.cjs tests/restarts.test.cjs tests/captions.test.cjs tests/mp4.test.cjs tests/demo-plan.test.cjs tests/demo.test.cjs tests/graph-layout.test.cjs tests/zoom.test.cjs tests/theme.test.cjs",
    "check": "npm run typecheck && npm run test:python && npm run test:main",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs dir",
    "package:win": "node scripts/package.mjs win"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "allowScripts": {
    "electron-winstaller": true
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.privateagent.desktop",
    "productName": "Private Agent",
    "copyright": "Copyright © 2026 Jae-Yul Woo",
    "publish": null,
    "asar": true,
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "dist/browsers",
        "to": "browsers"
      },
      {
        "from": "dist/backend",
        "to": "backend",
        "filter": [
          "private-agent-backend/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Private-Agent-${version}-${arch}.${ext}"
    },
    "nsis": {
      "script": "scripts/launcher.nsi",
      "packElevateHelper": false,
      "differentialPackage": false
    }
  }
}
