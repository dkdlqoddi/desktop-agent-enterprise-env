# OpenAI-compatible or Anthropic API. Set your own approved endpoint and model.
PROVIDER=general
API_FORMAT=openai
BASE_URL=
API_KEY=
MODEL_NAME=
# Custom headers as JSON; {api_key} uses API_KEY, {uuid} generates a request ID.
LLM_HEADERS=[]
TEMPERATURE=0.5
# Seconds one answer may take, including retries of temporary failures (HTTP 429/5xx, dropped connections).
LLM_TIMEOUT=300
# Optional CA certificate (PEM) of a server with a private or self-signed certificate; TLS verification stays on.
CA_BUNDLE=
# Cap of each answer in tokens (0: the server's own; 16000 for the Anthropic format), the model's context window in
# tokens (it bounds what a question sends), and LLM requests at once.
LLM_MAX_TOKENS=0
LLM_CONTEXT_WINDOW=64000
LLM_CONCURRENCY=3
