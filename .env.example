# OpenAI-compatible or Anthropic API. Set your own approved endpoint and model.
PROVIDER=general
API_FORMAT=openai
BASE_URL=
API_KEY=
MODEL_NAME=
# Custom headers as JSON; {api_key} uses API_KEY, {uuid} generates a request ID.
LLM_HEADERS=[]
TEMPERATURE=0.5
LLM_TIMEOUT=300
# Optional CA certificate (PEM) of a server with a private or self-signed certificate; TLS verification stays on.
CA_BUNDLE=
