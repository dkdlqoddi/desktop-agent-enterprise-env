<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- The adaptive launcher icons stay in mipmap-anydpi-v26: moved to mipmap-anydpi as this check suggests, the
         Android Gradle Plugin 8.13 resource merger files them under anydpi-v4 and they are not linked. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- abiFilters is set only with -PhermesAbis (a one-ABI APK for an emulator or a size measurement); the default
         APK has every ABI. -->
    <issue id="ChromeOsAbiSupport">
        <ignore path="build.gradle.kts" />
    </issue>
    <!-- Newer versions of Gradle, the plugins and the libraries come as Renovate's pull requests (renovate.json).
         These checks ask the network, so the same code would pass one day and warn the next, in the local CI too. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
</lint>
