# Without a trailing slash, so that a symbolic link to a shared node_modules or virtual environment (a second
# worktree) is ignored too.
node_modules
.next/
out/
dist/
release/
build/
.venv
__pycache__/
.pytest_cache/
*.egg-info/
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
test-results/
playwright-report/
*.tsbuildinfo
# Coverage data of npm run test:python:coverage.
.coverage
.coverage.*
htmlcov/
# Written into the package by scripts/package.mjs (the commit it was built from), never committed.
electron/build-info.json
.local-data/
# Local credentials, sessions and diagnostics must stay out of public source archives.
*.pem
*.key
*.p12
*.pfx
*.log
*-profiles/
storage-state*.json
settings.json
sites.json
api.json
*.spec
!tests/*.spec.*
